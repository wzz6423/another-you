{
  "version": 1,
  "dataDir": "~/Library/Application Support/AnotherYou",
  "tools": {
    "filesystem": true,
    "shell": true,
    "network": true,
    "calendar": false,
    "notifications": true
  },
  "privacy": {
    "mode": "local-first",
    "allowNetwork": true,
    "allowedNetworkHosts": [],
    "storePrompts": true,
    "storeResponses": true,
    "redactSecrets": true
  },
  "scheduler": {
    "enabled": true,
    "pollIntervalMs": 30000,
    "defaultCooldownMs": 1800000,
    "defaultDedupeWindowMs": 300000
  },
  "proactive": {
    "enabled": true,
    "workIntervalMs": 300000,
    "notificationsIntervalMs": 180000,
    "synthesisIntervalMs": 600000,
    "suggestionCooldownMs": 900000,
    "taskSpacingMs": 30000,
    "collectionTimeoutMs": 15000,
    "taskTimeoutMs": 90000
  },
  "permissionMode": "full-access"
}
